{
  "command": [
    "latexmk",
    "-g",
    "-lualatex",
    "-interaction=nonstopmode",
    "-halt-on-error",
    "RESIDUE_paper.tex"
  ],
  "returncode": 0,
  "local_format_fallback_used": true,
  "pdf_exists": true,
  "undefined_control_sequence": false,
  "undefined_citations": false,
  "overfull_boxes": 0,
  "underfull_boxes": 0,
  "missing_characters": 0,
  "optional_font_loader_fallback_notice": true,
  "tex_error_lines": []
}
