@article{ChuangHolsteinLazarev2021,
 author = {Joe Chuang and Julian Holstein and Andrey Lazarev},
 title = {Homotopy theory of monoids and derived localization},
 journal = {Journal of Homotopy and Related Structures},
 volume = {16}, pages = {175--189}, year = {2021},
 doi = {10.1007/s40062-021-00276-6},
 url = {https://arxiv.org/pdf/1810.00373},
 note = {Opened: primary arXiv v3, 29 September 2021; Section 2.3--2.5 definitions, Proposition 4.1, Corollary 5.1 and Theorem 5.2 with its proof inspected in the C-delta attempt. The equivalence of relative categories does not identify an ordinary colimit with the specified homotopy colimit. No missing comparison theorem is inferred from it.}
}
@article{Bergner2007Monoids,
 author = {Julia E. Bergner},
 title = {Simplicial monoids and Segal categories},
 journal = {Contemporary Mathematics}, volume = {431}, pages = {59--83}, year = {2007},
 url = {https://math.ucr.edu/~jbergner/SimpMonSubmit.pdf},
 note = {Opened: primary author PDF; Definitions 1.1--1.5, Proposition 4.2, Lemma 4.6, Proposition 4.7 and the accompanying homotopy-colimit discussion inspected. The later 2008 correction was also opened; the uncorrected Proposition 3.12 is not used. This source does not settle the C-delta comparison.}
}
@misc{Bergner2008Correction,
 author = {Julia E. Bergner},
 title = {Correction to ``Simplicial monoids and Segal categories''},
 year = {2008},
 url = {https://arxiv.org/pdf/0806.1767},
 note = {Opened in full: the three-page correction, Propositions 1--2 and 5--6, Definition 3 and Lemma 4. The original proposed adjoint pair did not preserve coproducts; the corrected rigidification adjunction is not treated as a theorem on arbitrary ordinary colimits of free monoids.}
}
@misc{PanovRayVogt2002,
 author = {Taras Panov and Nigel Ray and Rainer Vogt},
 title = {Colimits, {Stanley--Reisner} algebras, and loop spaces},
 year = {2002},
 eprint = {math/0202081}, archivePrefix = {arXiv},
 url = {https://arxiv.org/pdf/math/0202081},
 note = {Opened: primary arXiv v1, Propositions 7.10--7.11, Theorem 7.12 and its proof, and Propositions 7.14--7.15 with their proofs. Theorem 7.12 compares the classifying space of a homotopy colimit of well-pointed topological monoids with the based homotopy colimit of their classifying spaces. Proposition 7.15 gives a comparison square with ordinary colimits; it does not assert that its lower map is an equivalence. Published in Progress in Mathematics 215 (2004), pp. 261--291.}
}
