@misc{FGHStricklandToda,
  author = {Strickland, N. P.},
  title = {A {Mathematica} representation of some unstable homotopy groups of spheres},
  howpublished = {Author's note and accompanying program Toda.m},
  url = {https://strickland1.org/toda/toda.pdf},
  note = {Opened the author's undated PDF and the accompanying program at https://strickland1.org/toda/Toda.m, whose header is dated January 2004. Proposition 7, p.7, gives the pi14(S4) and pi15(S5) tables and suspension formulas; it was reopened and visually checked for D.2.46, including its explicit cyclic order-eight suspension kernel and Toda Theorem 7.3/equations (7.10), (7.16) attribution. Proposition 13, pp.8--9, proves (E nu-prime) sigma-prime equals twice E epsilon-prime. The opening warning about a general Hopf-composite formula is retained and its use is repaired in D.2.44 by the suspension hypothesis and the injective suspension on pi14(S7). The author program explicitly attributes the identity [iota5,iota5]=nu5 eta8 to Toda equations (5.10). For the note-only primary-composition quotient in the universal Moore composition note Section 14, the program block for pi14(S5), attributed to Toda Theorem 7.2 p.61, and its eta-composition relations were reopened on 16 November 2026. For D.2.49, Section 2.5 p.4 and Proposition 2 p.6 were reopened directly, together with the author program indexed-bracket convention and epsilon-prime declaration: epsilon-prime lies in the indexed bracket with entries nu-prime, twice nu6 and nu9, attributed to Toda Section VI(iv). The complete zero-first-entry ordinary-bracket indeterminacy is retained. For D.2.53, the author program sixth- and seventh-stem blocks were reopened: pi9(S3) is zero at the prime two, with its attribution to Toda Proposition 5.11 p.46; pi10(S3) and pi11(S4) are zero at the prime two, with their attribution to Proposition 5.15 p.50. The compatible cone representative and ordinary last-entry naturality are proved directly in that claim. For the incoming fifth-differential calculation, the program declaration of sigma-triple-prime as the unique ordinary bracket with entries nu5, eight times the identity and nu8, attributed to Toda Lemma 5.13, was reopened directly; the two successive suspension relations attributed to Lemma 5.14 were also reopened. These give the singleton ordinary bracket with entries nu7, eight times the identity and nu10 equal to four sigma-prime, with the full fourth-stem indeterminacy checked separately. For the auxiliary Chang calculation, the sixth-stem table and the order rule for nu-composites were reopened directly: the actual group pi12(S6) is cyclic of order two on nu6 nu9, with attribution to Toda Proposition 5.11 p.46. This input is not inferred from generic Freudenthal stability. The original Toda pages were not opened in this check; no source claim is upgraded to such an opening}
}

