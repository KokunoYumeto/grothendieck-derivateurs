% Les Dérivateurs companion: the commentary blocks set into Grothendieck's text (see FORMAT.md)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{derivateurs_companion}[2026/11/10]
\RequirePackage{framed}
\RequirePackage[a4paper,top=22mm,bottom=23mm,left=23mm,right=30mm,marginparwidth=23mm,marginparsep=5mm]{geometry}
\RequirePackage{microtype}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\setlength{\emergencystretch}{3em}
\newcounter{dcblock}
\def\dcgetpage p#1:#2\relax{#1}
\newcommand{\dcanchorpage}[1]{\dcgetpage#1:\relax}

\RequirePackage{xcolor}
\RequirePackage[round]{natbib}
\RequirePackage{hyperref}
\definecolor{dcbar}{gray}{0.55}
\newcommand{\dckind}[1]{%
  \ifx\relax#1\relax\else
  \def\dcexposition{exposition}\def\dccontext{context}\def\dclater{later}%
  \def\dcexamples{examples}\def\dcstatus{status}\def\dcdevelopment{development}%
  \def\dcarg{#1}%
  \ifx\dcarg\dcexposition Exposition\fi
  \ifx\dcarg\dccontext Context\fi
  \ifx\dcarg\dclater Later developments\fi
  \ifx\dcarg\dcexamples Examples\fi
  \ifx\dcarg\dcstatus Present state\fi
  \ifx\dcarg\dcdevelopment Development (commentators')\fi
  \fi}
% \begin{dcomment}{kind}{anchor}{title}: the commentators' text, set off from Grothendieck's by a bar and a smaller face
\newenvironment{dcomment}[3]{%
  \par\medskip
\Needspace{7\baselineskip}%
  \selectlanguage{english}%
  \refstepcounter{dcblock}%
  \pdfbookmark[1]{#3}{dc.\arabic{dcblock}}%
  \renewcommand{\FrameCommand}{{\color{dcbar}\vrule width 2.5pt}\hspace{8pt}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  \small\noindent{\scshape Commentary \textperiodcentered{} \dckind{#1}}\hfill{\footnotesize[ms.~\dcanchorpage{#2}]}\par
  \noindent\textbf{#3}\par\smallskip}
 {\endMakeFramed\medskip}
% \ours after the title of a result proved or constructed by the commentators (not a claim of priority)
\newcommand{\ours}{\textsuperscript{\,[ours]}\ }

% Compact the finding-aid entries without changing their text or page labels.
\newcommand{\dcindexentry}[2]{\par\begingroup\setlength{\parskip}{2pt}\noindent#1\dotfill\ #2\par\endgroup}
% The following front matter belongs to this reader, not to the French source.
\AtBeginDocument{%
\nocite{*}%
  \let\idx\dcindexentry
  \let\entry\dcindexentry
  \let\dcOriginalItem\item
  \RenewDocumentCommand{\item}{o}{%
    \IfNoValueTF{#1}{\dcOriginalItem}{%
      \ifstrequal{#1}{\textbullet}{\Needspace{8\baselineskip}}{}%
      \dcOriginalItem[#1]}}%
  \begingroup\selectlanguage{english}
  \thispagestyle{empty}
  \pdfbookmark[0]{Chapter XIII, part b: reader and companion}{reader.title}
  \vspace*{15mm}
  {\Large Alexander Grothendieck\par}
  \vspace{4mm}
  {\huge\bfseries Les D\'erivateurs\par}
  \vspace{3mm}
  {\Large Chapter XIII, part b\par}
  \vspace{8mm}
  {\large Transcription audit and mathematical commentary\par}
