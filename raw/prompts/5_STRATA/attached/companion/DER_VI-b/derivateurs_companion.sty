\newcommand{\dcreaderfrontmatter}{%
  \begingroup\selectlanguage{english}\thispagestyle{empty}
  \vspace*{8mm}
  {\Large Alexander Grothendieck\par}
  \vspace{5mm}
  {\huge\bfseries Les D\'erivateurs\par}
  \vspace{4mm}
  {\Large Chapter VI, part b\par}
  \vspace{8mm}
  {\large Audited reader and mathematical commentary\par}
  \vspace{3mm}
  {Manuscript pages 64--145\par}
  \vspace{10mm}
  \noindent This reader preserves the supplied French text, with verified transcription
  and rendering repairs, and inserts an English commentary. Edition slips remain
  visible in the text; their corrections and mathematical consequences are recorded
  separately in the commentary and the two audit tables. A synthetic overview follows
  the text. The companion ZIP includes the claim-by-claim audit, the corrections
  register, verified-source notes, and reproducible build files.\par
  \medskip
  \noindent The supplied transcription extends over printed edition pages 39--88.
  The attached PDF covers only printed pages 42--84. The missing margins were checked
  against the same official electronic edition; all 43 attached page content streams
  match its corresponding pages byte for byte. Manuscript and printed-edition page
  numbers are preserved in the outer margin.\par
  \medskip
  \noindent Electronic edition deciphered and transcribed by M.~K\"unzer,
  J.~Malgoire, and G.~Maltsiniotis. Original mathematical text:
  Alexander Grothendieck, 1990--1991.\par
  \vfill
  \noindent\small AI-produced commentary by GPT-6 Astra (OpenAI, ChatGPT Pro mode).
  The project brief credits editing with Claude (Anthropic); this is project-level
  credit and does not certify a separate Claude review of this execution.\par
  \smallskip
  \noindent Audit and compilation: 9 November 2026.\par
  \endgroup\clearpage
}
\newcommand{\dckind}[1]{%
  \ifx\relax#1\relax\else
  \def\dcexposition{exposition}\def\dccontext{context}\def\dclater{later}%
  \def\dcexamples{examples}\def\dcstatus{status}\def\dcdevelopment{development}%
  \def\dcarg{#1}%
  \ifx\dcarg\dcexposition Exposition\fi
  \ifx\dcarg\dccontext Context\fi
  \ifx\dcarg\dclater Later developments\fi
  \ifx\dcarg\dcexamples Examples\fi
  \ifx\dcarg\dcstatus Present state\fi
  \ifx\dcarg\dcdevelopment Development (commentators')\fi
  \fi}
% \begin{dcomment}{kind}{anchor}{title}: the commentators' text, set off from Grothendieck's by a bar and a smaller face
\newenvironment{dcomment}[3]{%
  \par\medskip
  \begin{otherlanguage}{english}%
  \refstepcounter{dcblock}%
  \pdfbookmark[1]{#3}{dcblock.\thedcblock}%
  \renewcommand{\FrameCommand}{{\color{dcbar}\vrule width 2.5pt}\hspace{8pt}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  \small\noindent{\scshape Commentary \textperiodcentered{} \dckind{#1}}\hfill{\footnotesize[ms.~\dcanchorpage{#2}]}\par
  \noindent\textbf{#3}\par\smallskip}
 {\endMakeFramed\end{otherlanguage}\medskip}
% \ours after the title of a result proved or constructed by the commentators (not a claim of priority)
\newcommand{\ours}{\textsuperscript{\,[ours]}}
